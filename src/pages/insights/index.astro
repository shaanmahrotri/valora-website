---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import InsightsBar from '../../components/InsightsBar.astro';

const settings = await getEntry('settings', 'index');
if (!settings.data.insightsEnabled) {
  return Astro.redirect('/');
}

const items = (await getCollection('insights', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);
const featured = items[0];
const rest = items.slice(1);
---

<Base title="Insights — Valora" active="insights" description="Writing on foundations, governance and the long work of family offices.">
  <InsightsBar />

  <section class="index">
    <div class="index__head">
      <div>
        <span class="kicker" style="margin-bottom:18px">Insights</span>
        <h2 class="index__title">Writing on foundations, governance and the long work of family offices.</h2>
      </div>
      <p class="index__count" id="result-count">{items.length} articles</p>
    </div>

    <!-- filter bar (visual; live search lives in the toolbar) -->
    <div class="filters">
      <div class="filters__group">
        <span class="filters__label">Author</span>
        <span class="filters__opt filters__opt--on">All</span>
        <span class="filters__opt">Shaan Mahrotri</span>
        <span class="filters__opt">Tom Rutherford</span>
      </div>
      <span class="filters__div"></span>
      <div class="filters__group">
        <span class="filters__label">Sort</span>
        <span class="filters__opt filters__opt--on">Newest</span>
        <span class="filters__opt">Oldest</span>
      </div>
    </div>

    <p class="index__empty" id="empty-state" hidden>No articles match your search.</p>

    <!-- FEATURED -->
    <a href={`/insights/${featured.slug}`} class="lead"
       data-article data-search={`${featured.data.title} ${featured.data.topic} ${featured.data.author}`.toLowerCase()}>
      <div class="lead__plate">
        <Plate ratio="7 / 5" label="Photograph · feature" note="A foundation set out in string lines across cleared ground. Beginnings, order, intent." spec="1400 × 1000" />
        <span class="lead__badge">Featured</span>
      </div>
      <div>
        <div class="lead__meta"><span class="gold-tick"></span><span class="lead__topic">{featured.data.topic}</span></div>
        <h3 class="lead__title">{featured.data.title}</h3>
        <p class="lead__excerpt">{featured.data.excerpt}</p>
        <p class="lead__byline">{featured.data.author} · {featured.data.read} · {featured.data.date}</p>
      </div>
    </a>

    <!-- NUMBERED LIST -->
    <div id="article-list">
      {rest.map((a, i) => (
        <a href={`/insights/${a.slug}`} class="row"
           data-article data-search={`${a.data.title} ${a.data.topic} ${a.data.author}`.toLowerCase()}>
          <span class="row__num">{String(i + 2).padStart(2, '0')}</span>
          <Plate ratio="5 / 4" />
          <div>
            <div class="microlabel" style="margin-bottom:10px">{a.data.topic}</div>
            <h4 class="row__title">{a.data.title}</h4>
          </div>
          <div class="row__meta">
            <div>{a.data.author}</div>
            <div>{a.data.read.replace(' read', '')} · {a.data.date}</div>
          </div>
        </a>
      ))}
    </div>

    <!-- pagination (visual) -->
    <div class="pager">
      <span class="pager__n pager__n--on">1</span>
      <span class="pager__n">2</span>
      <span class="pager__n">3</span>
      <span class="pager__next">›</span>
    </div>
  </section>
</Base>

<script>
  // Client-side live search wired to the toolbar input.
  const input = document.getElementById('insights-search') as HTMLInputElement | null;
  const articles = Array.from(document.querySelectorAll<HTMLElement>('[data-article]'));
  const count = document.getElementById('result-count');
  const empty = document.getElementById('empty-state');
  const total = articles.length;

  function apply(q: string) {
    const query = q.trim().toLowerCase();
    let shown = 0;
    for (const el of articles) {
      const hit = !query || (el.dataset.search || '').includes(query);
      el.style.display = hit ? '' : 'none';
      if (hit) shown++;
    }
    if (count) count.textContent = `${shown} ${shown === 1 ? 'article' : 'articles'}`;
    if (empty) empty.hidden = shown !== 0;
  }

  input?.addEventListener('input', () => apply(input.value));
</script>

<style>
  .index { padding: 80px var(--pad) 104px; }
  .index__head { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 44px; }
  .index__title { font-size: 34px; font-weight: 300; color: var(--ink); line-height: 1.22; letter-spacing: -0.4px; max-width: 14em; }
  .index__count { font-size: 13px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint-alt); white-space: nowrap; }
  .index__empty { padding: 56px 0; text-align: center; font-size: 15px; color: var(--faint); }

  .filters { display: flex; align-items: center; flex-wrap: wrap; gap: 32px; padding: 18px 0; border-top: 1px solid var(--divider); border-bottom: 1px solid var(--divider); margin-bottom: 8px; }
  .filters__group { display: flex; align-items: baseline; gap: 16px; }
  .filters__label { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--faint-alt); }
  .filters__opt { font-size: 13px; font-weight: 400; color: var(--muted); padding-bottom: 3px; }
  .filters__opt--on { font-weight: 500; color: var(--ink); border-bottom: 2px solid var(--gold); }
  .filters__div { width: 1px; height: 18px; background: var(--divider); }

  .microlabel { font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }

  .lead { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,1fr); gap: 56px; align-items: center; padding: 44px 0; border-bottom: 1px solid var(--divider); }
  .lead__plate { position: relative; }
  .lead__badge { position: absolute; top: 16px; left: 16px; font-size: 10px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-ink); background: rgba(230,221,208,0.82); padding: 5px 10px; }
  .lead__meta { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .gold-tick { width: 24px; height: 2px; background: var(--gold); }
  .lead__topic { font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
  .lead__title { font-size: 32px; font-weight: 300; color: var(--ink); line-height: 1.24; letter-spacing: -0.3px; }
  .lead:hover .lead__title { color: var(--gold-deep); }
  .lead__excerpt { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.85; margin-top: 20px; max-width: 32em; }
  .lead__byline { font-size: 13px; font-weight: 400; color: var(--faint); letter-spacing: 0.04em; margin-top: 24px; }

  .row { display: grid; grid-template-columns: 64px 150px minmax(0,1fr) auto; gap: 32px; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--divider); transition: background 0.15s; }
  .row:hover { background: rgba(58,56,39,0.022); }
  .row__num { font-size: 30px; font-weight: 300; color: #C2B79D; letter-spacing: -1px; }
  .row__title { font-size: 21px; font-weight: 300; color: var(--ink); letter-spacing: -0.2px; line-height: 1.3; }
  .row__meta { font-size: 13px; font-weight: 400; color: var(--faint); text-align: right; line-height: 1.6; white-space: nowrap; }

  .pager { display: flex; align-items: center; justify-content: center; gap: 18px; margin-top: 48px; }
  .pager__n { font-size: 13px; font-weight: 400; color: var(--faint-alt); width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; }
  .pager__n--on { font-weight: 600; color: var(--ink); border-bottom: 2px solid var(--gold); }
  .pager__next { font-size: 14px; color: var(--faint-alt); }

  @media (max-width: 900px) {
    .lead { grid-template-columns: 1fr; gap: 28px; }
    .row { grid-template-columns: 44px 1fr; gap: 18px; }
    .row :global(.plate), .row__meta { display: none; }
  }
</style>
