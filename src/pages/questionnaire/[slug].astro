---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const questionnaires = await getCollection('questionnaires');
  return questionnaires.map((entry) => ({
    params: { slug: entry.id },
    props: { questionnaire: entry.data },
  }));
}

const { slug } = Astro.params;
const { questionnaire } = Astro.props;
const { gate, sections, closing } = questionnaire;

function scaleRange(min = 1, max = 5) {
  return Array.from({ length: max - min + 1 }, (_, i) => min + i);
}

const closingFieldLabels: Record<string, string> = {
  name: 'Name',
  organisation: 'Family office name',
  email: 'Email',
};

// Step order: [gate?] [one per section] [closing?] - the closing step only
// ever gets shown at runtime if someone answers the gate question "yes";
// otherwise the client script skips straight from the last section to the
// thank-you state.
const stepCount = (gate ? 1 : 0) + sections.length + (closing ? 1 : 0);
---
<Base title={`${questionnaire.title} — Valora`} description={questionnaire.intro} noindex={true}>

  <div class="qpage">

    <header class="qpage__head">
      <span class="kicker" style="margin-bottom:20px">Questionnaire</span>
      <div class="gold-rule" style="margin-bottom:32px"></div>
      <h1 class="qpage__title">{questionnaire.title}</h1>
      <p class="qpage__intro">{questionnaire.intro}</p>
    </header>

    <div
      class="qform"
      id="qform"
      data-slug={slug}
      data-form-version={questionnaire.formVersion}
      data-gate-id={gate?.id ?? ''}
      data-gate-yes={gate?.yesLabel ?? ''}
    >
      <div class="qform__progress">
        <div
          class="qform__progress-track"
          role="progressbar"
          aria-valuemin="1"
          aria-valuemax={stepCount}
          aria-valuenow="1"
          id="qform-progress-track"
        >
          <div class="qform__progress-fill" id="qform-progress-fill"></div>
        </div>
        <span class="qform__progress-label" id="qform-progress-label">Step 1 of {stepCount}</span>
      </div>

      <form id="qform-form" novalidate>

        {gate && (
          <section class="qform__step" data-step="0" data-kind="gate">
            <fieldset class="qform__q" data-qid={gate.id} data-type="single">
              <legend class="qform__prompt">{gate.prompt}</legend>
              <label class="qform__option">
                <input type="radio" name={`q_${gate.id}`} value={gate.yesLabel} required />
                <span>{gate.yesLabel}</span>
              </label>
              <label class="qform__option">
                <input type="radio" name={`q_${gate.id}`} value={gate.noLabel} required />
                <span>{gate.noLabel}</span>
              </label>
              {gate.note && <p class="qform__note">{gate.note}</p>}
            </fieldset>
          </section>
        )}

        {sections.map((section, i) => (
          <section class="qform__step" data-step={(gate ? 1 : 0) + i} data-kind="section">
            {section.heading && <p class="qform__section-heading">{section.heading}</p>}
            {section.intro && <p class="qform__section-intro">{section.intro}</p>}

            {section.questions.map((q) => (
              <fieldset
                class="qform__q"
                data-qid={q.id}
                data-type={q.type}
                data-show-if-q={q.showIfQuestionId ?? ''}
                data-show-if-values={q.showIfValues ? JSON.stringify(q.showIfValues) : ''}
                hidden={Boolean(q.showIfQuestionId)}
              >
                <legend class="qform__prompt">{q.prompt}</legend>

                {q.type === 'scale' && (
                  <div class="qform__scale">
                    <span class="qform__scale-label">{q.scaleMinLabel}</span>
                    <div class="qform__scale-options">
                      {scaleRange(q.scaleMin, q.scaleMax).map((n) => (
                        <label class="qform__scale-opt">
                          <input type="radio" name={`q_${q.id}`} value={n} required />
                          <span>{n}</span>
                        </label>
                      ))}
                    </div>
                    <span class="qform__scale-label">{q.scaleMaxLabel}</span>
                  </div>
                )}

                {(q.type === 'single' || q.type === 'multi' || q.type === 'rankTwo') && (
                  <div class="qform__options" data-max={q.maxSelections ?? (q.type === 'rankTwo' ? 2 : '')}>
                    {q.options?.map((opt) => (
                      <label class={`qform__option${q.type === 'rankTwo' ? ' qform__option--rank' : ''}`}>
                        <input
                          type={q.type === 'single' ? 'radio' : 'checkbox'}
                          name={`q_${q.id}`}
                          value={opt}
                          required={q.type === 'single'}
                        />
                        <span>{opt}</span>
                        {q.type === 'rankTwo' && <span class="qform__rank-badge" hidden></span>}
                      </label>
                    ))}
                  </div>
                )}

                {q.type === 'grid' && (
                  <div class="qform__grid" data-follow-col={q.gridFollowUpColumn ?? ''}>
                    {q.gridRows?.map((row) => (
                      <div class="qform__grid-row" data-row-id={row.id}>
                        <p class="qform__grid-row-label">{row.label}</p>
                        <div class="qform__grid-row-opts">
                          {q.gridColumns?.map((col) => (
                            <label class="qform__grid-opt">
                              <input type="radio" name={`q_${q.id}__${row.id}`} value={col} required />
                              <span>{col}</span>
                            </label>
                          ))}
                        </div>
                        {q.gridFollowUpPrompt && (
                          <div class="qform__detail" data-detail-for={`${q.id}__${row.id}`} hidden>
                            <label class="qform__field">
                              <span>{q.gridFollowUpPrompt}</span>
                              <input type="text" name={`detail_${q.id}__${row.id}`} />
                            </label>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                )}

                {q.type === 'open' && (
                  <label class="qform__field qform__field--open">
                    <textarea name={`q_${q.id}`} rows="3"></textarea>
                  </label>
                )}

                {q.detailPrompt && q.type !== 'grid' && (
                  <div
                    class="qform__detail"
                    data-detail-for={q.id}
                    data-allow-values={q.detailShowIfValues ? JSON.stringify(q.detailShowIfValues) : ''}
                    hidden
                  >
                    <label class="qform__field">
                      <span>{q.detailPrompt}</span>
                      <input type="text" name={`detail_${q.id}`} />
                    </label>
                  </div>
                )}
              </fieldset>
            ))}
          </section>
        ))}

        {closing && (
          <section class="qform__step" data-step={(gate ? 1 : 0) + sections.length} data-kind="closing">
            <div class="qform__contact">
              <p class="qform__contact-lead">{closing.leadText}</p>

              <div class="qform__contact-fields">
                {closing.fields.includes('name') && (
                  <label class="qform__field">
                    <span>{closingFieldLabels.name} (optional)</span>
                    <input type="text" name="name" autocomplete="name" />
                  </label>
                )}
                {closing.fields.includes('organisation') && (
                  <label class="qform__field">
                    <span>{closingFieldLabels.organisation} (optional)</span>
                    <input type="text" name="organisation" autocomplete="organization" />
                  </label>
                )}
                {closing.fields.includes('email') && (
                  <label class="qform__field">
                    <span>{closingFieldLabels.email}</span>
                    <input type="email" name="email" autocomplete="email" />
                  </label>
                )}
              </div>

              {closing.offerMarketingConsent && (
                <label class="qform__check">
                  <input type="checkbox" id="marketing-consent" name="marketingConsent" />
                  <span>{closing.marketingLabel ?? "I'd also like to be contacted about your services"}</span>
                </label>
              )}

              <p class="qform__privacy">{closing.consentNote}</p>
            </div>

            <div class="qform__hp" aria-hidden="true">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
            </div>
          </section>
        )}
      </form>

      <div class="qform__nav">
        <button type="button" id="qform-back" class="qform__btn qform__btn--ghost" hidden>Back</button>
        <button type="button" id="qform-next" class="qform__btn qform__btn--gold">Next</button>
        <button type="button" id="qform-submit" class="qform__btn qform__btn--gold" hidden>{questionnaire.submitLabel}</button>
      </div>

      <p class="qform__error" id="qform-error" hidden></p>

      <div class="qform__thanks" id="qform-thanks" hidden>
        <div class="gold-rule" style="margin-bottom:24px"></div>
        <h2>Thank you</h2>
        <p id="qform-thanks-message">Your answers have been received.</p>
      </div>
    </div>

  </div>

</Base>

<script>
  type AnswerValue = string | string[] | Record<string, { value: string; detail?: string }> | null;
  interface AnswerRecord {
    id: string;
    prompt: string;
    type: string;
    value: AnswerValue;
    detail?: string | null;
  }

  const container = document.getElementById('qform') as HTMLElement;
  const form = document.getElementById('qform-form') as HTMLFormElement;
  const steps = Array.from(form.querySelectorAll<HTMLElement>('.qform__step'));

  const backBtn = document.getElementById('qform-back') as HTMLButtonElement;
  const nextBtn = document.getElementById('qform-next') as HTMLButtonElement;
  const submitBtn = document.getElementById('qform-submit') as HTMLButtonElement;
  const progressFill = document.getElementById('qform-progress-fill') as HTMLElement;
  const progressTrack = document.getElementById('qform-progress-track') as HTMLElement;
  const progressLabel = document.getElementById('qform-progress-label') as HTMLElement;
  const errorEl = document.getElementById('qform-error') as HTMLElement;
  const thanks = document.getElementById('qform-thanks') as HTMLElement;
  const thanksMessage = document.getElementById('qform-thanks-message') as HTMLElement;
  const nav = document.querySelector('.qform__nav') as HTMLElement;

  const marketingCheckbox = document.getElementById('marketing-consent') as HTMLInputElement | null;
  const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
  const nameInput = form.querySelector<HTMLInputElement>('input[name="name"]');
  const organisationInput = form.querySelector<HTMLInputElement>('input[name="organisation"]');
  const honeypot = form.querySelector<HTMLInputElement>('#company');

  const slug = container.dataset.slug || '';
  const formVersion = Number(container.dataset.formVersion || '1');
  const gateId = container.dataset.gateId || '';
  const gateYesValue = container.dataset.gateYes || '';
  const answersKey = `questionnaire:${slug}:answers`;
  const stepKey = `questionnaire:${slug}:step`;
  const clientToken = crypto.randomUUID();
  const originalSubmitLabel = submitBtn.textContent || 'Submit';

  const rankOrder = new Map<string, string[]>(); // qid -> option values in click order

  let current = 0;

  function isClosingStep(index: number): boolean {
    return steps[index]?.dataset.kind === 'closing';
  }

  function gateAnsweredYes(): boolean {
    if (!gateId) return true; // no gate configured - closing (if any) is always reachable
    const checked = form.querySelector<HTMLInputElement>(`input[name="q_${CSS.escape(gateId)}"]:checked`);
    return checked?.value === gateYesValue;
  }

  function stepIsApplicable(index: number): boolean {
    if (index < 0 || index >= steps.length) return false;
    if (isClosingStep(index)) return gateAnsweredYes();
    return true;
  }

  function findApplicableStep(from: number, direction: 1 | -1): number {
    let i = from + direction;
    while (i >= 0 && i < steps.length && !stepIsApplicable(i)) i += direction;
    return i >= 0 && i < steps.length ? i : -1;
  }

  function applicableStepCount(): number {
    return steps.filter((_, i) => stepIsApplicable(i)).length;
  }

  function applicablePositionOf(index: number): number {
    return steps.slice(0, index + 1).filter((_, i) => stepIsApplicable(i)).length;
  }

  function evaluateConditionalQuestions() {
    form.querySelectorAll<HTMLElement>('.qform__q[data-show-if-q]').forEach((qEl) => {
      const controllingId = qEl.dataset.showIfQ;
      if (!controllingId) return;
      const allowedRaw = qEl.dataset.showIfValues || '[]';
      let allowed: string[] = [];
      try { allowed = JSON.parse(allowedRaw); } catch { allowed = []; }
      const controllingValue = getAnswerValue(controllingId);
      const matches = Array.isArray(controllingValue)
        ? controllingValue.some((v) => allowed.includes(v))
        : typeof controllingValue === 'string' && allowed.includes(controllingValue);
      qEl.hidden = !matches;
    });
  }

  function evaluateDetailReveals() {
    form.querySelectorAll<HTMLElement>('.qform__detail[data-detail-for]').forEach((detailEl) => {
      const forId = detailEl.dataset.detailFor || '';
      // Grid follow-ups are keyed "qid__rowid" and handled separately below.
      if (forId.includes('__')) return;
      const qEl = form.querySelector<HTMLElement>(`.qform__q[data-qid="${CSS.escape(forId)}"]`);
      if (!qEl) return;
      const allowListRaw = detailEl.dataset.allowValues;
      const value = getAnswerValue(forId);
      const hasAnswer = Array.isArray(value) ? value.length > 0 : Boolean(value);
      if (!allowListRaw) {
        detailEl.hidden = !hasAnswer;
        return;
      }
      let allowed: string[] = [];
      try { allowed = JSON.parse(allowListRaw); } catch { allowed = []; }
      const matches = Array.isArray(value) ? value.some((v) => allowed.includes(v)) : typeof value === 'string' && allowed.includes(value);
      detailEl.hidden = !matches;
    });
  }

  function evaluateGridFollowUps() {
    form.querySelectorAll<HTMLElement>('.qform__grid').forEach((gridEl) => {
      const followCol = gridEl.dataset.followCol;
      if (!followCol) return;
      gridEl.querySelectorAll<HTMLElement>('.qform__grid-row').forEach((rowEl) => {
        const rowId = rowEl.dataset.rowId;
        const checked = rowEl.querySelector<HTMLInputElement>('input[type="radio"]:checked');
        const detailEl = rowEl.querySelector<HTMLElement>('.qform__detail');
        if (detailEl) detailEl.hidden = checked?.value !== followCol;
      });
    });
  }

  function getAnswerValue(qid: string): string | string[] | null {
    const qEl = form.querySelector<HTMLElement>(`.qform__q[data-qid="${CSS.escape(qid)}"]`);
    if (!qEl) return null;
    const type = qEl.dataset.type;
    if (type === 'multi' || type === 'rankTwo') {
      const values = Array.from(qEl.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')).map((i) => i.value);
      return values.length ? values : null;
    }
    const checked = qEl.querySelector<HTMLInputElement>('input[type="radio"]:checked, input[type="checkbox"]:checked');
    if (checked) return checked.value;
    const textInput = qEl.querySelector<HTMLTextAreaElement | HTMLInputElement>('textarea, input[type="text"]');
    return textInput?.value.trim() || null;
  }

  function refreshDerivedState() {
    evaluateConditionalQuestions();
    evaluateDetailReveals();
    evaluateGridFollowUps();
  }

  function showStep(index: number) {
    current = Math.max(0, Math.min(index, steps.length - 1));
    steps.forEach((el, i) => { el.hidden = i !== current; });

    const backTarget = findApplicableStep(current, -1);
    backBtn.hidden = backTarget < 0;

    const isLastApplicable = findApplicableStep(current, 1) === -1;
    nextBtn.hidden = isLastApplicable;
    submitBtn.hidden = !isLastApplicable;
    errorEl.hidden = true;

    const stepNum = applicablePositionOf(current);
    const total = applicableStepCount();
    progressLabel.textContent = `Step ${stepNum} of ${total}`;
    progressTrack.setAttribute('aria-valuenow', String(stepNum));
    progressTrack.setAttribute('aria-valuemax', String(total));
    progressFill.style.width = `${(stepNum / total) * 100}%`;
    sessionStorage.setItem(stepKey, String(current));
  }

  function validateStep(index: number): boolean {
    const stepEl = steps[index];
    const fieldsets = stepEl.querySelectorAll<HTMLFieldSetElement>('fieldset.qform__q');
    for (const fs of Array.from(fieldsets)) {
      if (fs.hidden) continue; // conditionally hidden - not required
      const type = fs.dataset.type;
      if (type === 'open') continue; // free text is optional
      if (type === 'grid') {
        const rows = fs.querySelectorAll<HTMLElement>('.qform__grid-row');
        for (const row of Array.from(rows)) {
          if (!row.querySelector('input[type="radio"]:checked')) {
            fs.classList.add('qform__q--error');
            fs.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
          }
        }
        fs.classList.remove('qform__q--error');
        continue;
      }
      const hasChecked = fs.querySelector('input[type="radio"]:checked, input[type="checkbox"]:checked');
      if (!hasChecked) {
        fs.classList.add('qform__q--error');
        fs.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
      }
      fs.classList.remove('qform__q--error');
    }
    return true;
  }

  function collectAnswers(): AnswerRecord[] {
    const answers: AnswerRecord[] = [];
    form.querySelectorAll<HTMLFieldSetElement>('fieldset.qform__q').forEach((fs) => {
      const id = fs.dataset.qid!;
      const type = fs.dataset.type!;
      const prompt = fs.querySelector('legend')?.textContent ?? '';
      const detailInput = fs.querySelector<HTMLInputElement>(`input[name="detail_${CSS.escape(id)}"]`);

      if (type === 'grid') {
        const value: Record<string, { value: string; detail?: string }> = {};
        fs.querySelectorAll<HTMLElement>('.qform__grid-row').forEach((row) => {
          const rowId = row.dataset.rowId!;
          const checked = row.querySelector<HTMLInputElement>('input[type="radio"]:checked');
          const rowDetail = row.querySelector<HTMLInputElement>(`input[name="detail_${CSS.escape(id)}__${CSS.escape(rowId)}"]`);
          value[rowId] = { value: checked?.value ?? '', detail: rowDetail?.value.trim() || undefined };
        });
        answers.push({ id, prompt, type, value });
        return;
      }

      if (type === 'multi' || type === 'rankTwo') {
        const order = rankOrder.get(id);
        const checkedValues = Array.from(fs.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked')).map((i) => i.value);
        const value = type === 'rankTwo' && order?.length ? order.filter((v) => checkedValues.includes(v)) : checkedValues;
        answers.push({ id, prompt, type, value, detail: detailInput?.value.trim() || null });
        return;
      }

      if (type === 'open') {
        const textInput = fs.querySelector<HTMLTextAreaElement>('textarea');
        answers.push({ id, prompt, type, value: textInput?.value.trim() || null });
        return;
      }

      // scale / single
      const checked = fs.querySelector<HTMLInputElement>('input[type="radio"]:checked');
      answers.push({ id, prompt, type, value: checked?.value ?? null, detail: detailInput?.value.trim() || null });
    });
    return answers;
  }

  function saveProgress() {
    const data: Record<string, string> = {};
    form.querySelectorAll<HTMLInputElement>('input[type="radio"]:checked, input[type="checkbox"]:checked').forEach((input) => {
      data[`${input.name}::${input.value}`] = '1';
    });
    form.querySelectorAll<HTMLInputElement>('input[type="text"], input[type="email"]').forEach((input) => {
      if (input.id === 'company') return; // never persist the honeypot
      if (input.value) data[`__text__${input.name}`] = input.value;
    });
    form.querySelectorAll<HTMLTextAreaElement>('textarea').forEach((ta) => {
      if (ta.value) data[`__text__${ta.name}`] = ta.value;
    });
    sessionStorage.setItem(answersKey, JSON.stringify(data));
  }

  function restoreProgress() {
    const raw = sessionStorage.getItem(answersKey);
    if (!raw) return;
    try {
      const data = JSON.parse(raw) as Record<string, string>;
      Object.entries(data).forEach(([key, value]) => {
        if (key.startsWith('__text__')) {
          const name = key.slice('__text__'.length);
          const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${CSS.escape(name)}"]`);
          if (input) input.value = value;
          return;
        }
        const [name, val] = key.split('::');
        const input = form.querySelector<HTMLInputElement>(`input[name="${CSS.escape(name)}"][value="${CSS.escape(val)}"]`);
        if (input) {
          input.checked = true;
          if (input.type === 'checkbox' && input.closest('.qform__q')?.dataset.type === 'rankTwo') {
            const qid = input.closest<HTMLElement>('.qform__q')?.dataset.qid;
            if (qid) {
              const order = rankOrder.get(qid) ?? [];
              order.push(input.value);
              rankOrder.set(qid, order);
            }
          }
        }
      });
    } catch {
      // ignore malformed sessionStorage state
    }
  }

  function updateRankBadges(fs: HTMLElement) {
    const qid = fs.dataset.qid!;
    const order = rankOrder.get(qid) ?? [];
    fs.querySelectorAll<HTMLElement>('.qform__option--rank').forEach((label) => {
      const input = label.querySelector<HTMLInputElement>('input');
      const badge = label.querySelector<HTMLElement>('.qform__rank-badge');
      if (!input || !badge) return;
      const pos = order.indexOf(input.value);
      if (input.checked && pos !== -1) {
        badge.hidden = false;
        badge.textContent = String(pos + 1);
      } else {
        badge.hidden = true;
      }
    });
  }

  form.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    const qEl = target.closest<HTMLElement>('.qform__q');

    if (qEl?.dataset.type === 'multi' || qEl?.dataset.type === 'rankTwo') {
      const qid = qEl.dataset.qid!;
      const max = Number(qEl.querySelector<HTMLElement>('.qform__options')?.dataset.max || '0');
      const boxes = Array.from(qEl.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
      let order = rankOrder.get(qid) ?? [];

      if (target.checked) {
        order.push(target.value);
      } else {
        order = order.filter((v) => v !== target.value);
      }
      rankOrder.set(qid, order);

      const checkedCount = boxes.filter((b) => b.checked).length;
      if (max > 0) {
        boxes.forEach((b) => { if (!b.checked) b.disabled = checkedCount >= max; });
      }
      if (qEl.dataset.type === 'rankTwo') updateRankBadges(qEl);
    }

    refreshDerivedState();
  });

  nextBtn.addEventListener('click', () => {
    if (!validateStep(current)) return;
    saveProgress();
    const next = findApplicableStep(current, 1);
    if (next !== -1) showStep(next);
  });

  backBtn.addEventListener('click', () => {
    const prev = findApplicableStep(current, -1);
    if (prev !== -1) showStep(prev);
  });

  submitBtn.addEventListener('click', async () => {
    if (!validateStep(current)) return;

    const email = emailInput?.value.trim() || '';
    const wantsReport = gateAnsweredYes();
    const marketingConsent = marketingCheckbox?.checked ?? false;

    if (wantsReport && closing && !email) {
      errorEl.hidden = false;
      errorEl.textContent = 'Please enter an email address to continue.';
      return;
    }

    const payload = {
      questionnaireSlug: slug,
      formVersion,
      clientToken,
      company: honeypot?.value || '',
      answers: collectAnswers(),
      wantsReport,
      marketingConsent,
      name: nameInput?.value.trim() || '',
      organisation: organisationInput?.value.trim() || '',
      email,
    };

    errorEl.hidden = true;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    try {
      const res = await fetch('/.netlify/functions/submit-questionnaire', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('Request failed');

      sessionStorage.removeItem(answersKey);
      sessionStorage.removeItem(stepKey);
      form.hidden = true;
      nav.hidden = true;
      thanks.hidden = false;
      thanksMessage.textContent = marketingConsent
        ? "Your answers have been received. Check your inbox to confirm you'd like to hear from us."
        : wantsReport
          ? 'Your answers have been received — a copy is on its way to your inbox.'
          : 'Your answers have been received.';
    } catch {
      errorEl.hidden = false;
      errorEl.textContent = 'Something went wrong sending your answers. Please try again.';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalSubmitLabel;
    }
  });

  restoreProgress();
  refreshDerivedState();
  const savedStep = Number(sessionStorage.getItem(stepKey) ?? '0');
  showStep(Number.isFinite(savedStep) && stepIsApplicable(savedStep) ? savedStep : 0);
</script>

