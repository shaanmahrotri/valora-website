---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const page = await getEntry('legal', 'privacy');
---
<Base title="Privacy Policy — Valora" description="How Valora Partners handles personal data in connection with this website.">

  <div class="legal">

    <a href="/" class="back">← Back to main</a>

    <header class="legal__head">
      <span class="kicker" style="margin-bottom:20px"><span class="kicker__mark">/</span><span class="kicker__label">Legal</span></span>
      <div class="gold-rule" style="margin-bottom:32px"></div>
      <h1 class="legal__title">{page.data.title}</h1>
      <p class="legal__date">Last updated: {page.data.lastUpdated}</p>
    </header>

    <div class="legal__body">
      {page.data.sections.map((section) => (
        <section class="legal__section">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((p) => <p set:html={p} />)}
        </section>
      ))}
    </div>

    <nav class="legal__footer">
      <a href="/cookies">Cookie Policy</a>
      <span class="legal__footer-sep"></span>
      <a href="/terms">Terms of Use</a>
      <span class="legal__footer-sep"></span>
      <a href="/disclaimer">Disclaimer</a>
    </nav>

  </div>

</Base>

<style>
  .legal { padding: 80px var(--pad) 104px; max-width: 680px; }

  .back {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 56px;
    transition: color 0.15s;
  }
  .back:hover { color: var(--ink); }

  .legal__head { margin-bottom: 52px; }
  .legal__title { font-size: 42px; font-weight: 300; color: var(--ink); line-height: 1.2; letter-spacing: -0.3px; margin-bottom: 14px; text-wrap: balance; }
  .legal__date { font-size: 13px; font-weight: 400; color: var(--muted); letter-spacing: 0.04em; }

  .legal__section { padding: 32px 0; border-top: 1px solid var(--divider); }
  .legal__section h2 {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 18px;
  }
  .legal__section p {
    font-size: 16px;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.9;
  }
  .legal__section p + p { margin-top: 14px; }
  /* :global() because these links arrive via set:html (raw HTML from
     content, not Astro-authored markup) - Astro never sees them at build
     time, so the scoped-style attribute never gets stamped on and a plain
     ".legal__link" rule silently never matches. */
  :global(.legal__link) {
    color: var(--ink);
    border-bottom: 1px solid var(--divider);
    padding-bottom: 1px;
    transition: border-color 0.15s;
  }
  :global(.legal__link:hover) { border-color: var(--gold); }

  .legal__footer {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--divider);
  }
  .legal__footer a {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.15s;
  }
  .legal__footer a:hover { color: var(--ink); }
  .legal__footer-sep { width: 1px; height: 12px; background: var(--divider); }
</style>
