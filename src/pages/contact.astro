---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Valora — Contact" pageLabel="Contact" active="contact">
  <div class="contact-block">
    <p class="contact-intro">We work with a small number of families at any one time. If you'd like to explore whether we're the right fit, the best first step is a conversation.</p>
    <div class="contact-person">
      <span class="contact-name">Tom Rutherford</span>
      <a href="mailto:tom@valorapartners.co.uk" class="contact-email">tom@valorapartners.co.uk</a>
    </div>
    <div class="contact-person">
      <span class="contact-name">Shaan Mahrotri</span>
      <a href="mailto:shaan@valorapartners.co.uk" class="contact-email">shaan@valorapartners.co.uk</a>
    </div>
  </div>
</Layout>
