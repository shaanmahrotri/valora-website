---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Valora — Partners" pageLabel="Partners" active="partners">
  <div class="partners">

    <div class="partner">
      <div class="partner-header">
        <img src="/assets/tom.jpg" alt="Tom Rutherford" class="partner-photo" />
        <div>
          <p class="partner-name">Tom Rutherford</p>
          <p class="partner-title">Family Office and Trust Advisor</p>
        </div>
      </div>
      <div class="partner-bio">
        <p>Nearly thirty years advising family offices and international trusts. Formed LOTUC Consulting in 2018 recognising the need for strategic advice incorporating sustainability alongside traditional frameworks.</p>
        <p>JPMorgan Private Bank, managing director leading charities and international manager due diligence team. Previous portfolio management experience at Lombard Odier and Robert Fleming & Co.</p>
      </div>
    </div>

    <div class="partner">
      <div class="partner-header">
        <img src="/assets/shaan.jpg" alt="Shaan Mahrotri" class="partner-photo" />
        <div>
          <p class="partner-name">Shaan Mahrotri</p>
          <p class="partner-title">Strategic Advisor and Investor</p>
        </div>
      </div>
      <div class="partner-bio">
        <p>Accomplished operational advisor to investment houses, family offices, and UHNW individuals with over 25 years of expertise across diverse industries and geographies.</p>
        <p>Bridges strategy and execution through deep commercial expertise and extensive global network. Trusted advisor to principals and hands-on operator with portfolio companies, focusing on driving innovation and growth.</p>
      </div>
    </div>

  </div>
</Layout>
