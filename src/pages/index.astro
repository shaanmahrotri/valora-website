---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';

const insights = (await getCollection('insights')).sort((a, b) => a.data.order - b.data.order);
const featured = insights[0];
const summary = insights.slice(1, 4);
---

<Base title="Valora — Fractional Family Office Architecture" active="about">

  <!-- HERO -->
  <section id="about" class="hero">
    <div class="hero__text">
      <span class="kicker" style="margin-bottom:36px">Fractional Family Office Architecture</span>
      <h1>We help families build offices that work for them.</h1>
      <div class="hero__body">
        <p>Family offices that begin with strategic foundations - values, identity, how decisions are made - are built to last. Structure, governance and investment policy all perform differently when they emerge from a clear sense of who the family is.</p>
        <p>We work with families at every stage - building from scratch, refining what exists or navigating transition - always at your cadence, not ours.</p>
      </div>
      <p class="hero__maxim">Foundation first. Operations second. Evolution always.</p>
    </div>
    <div class="hero__plate">
      <Plate fill={true} src="/hero.jpg" alt="A quiet, well-kept study in soft morning daylight" label="Photograph · hero" note="A quiet, well-kept study in soft morning daylight. Architecture and stillness, no people. Warm neutral tones, deep negative space." spec="1600 × 1800" />
    </div>
  </section>

  <!-- APPROACH -->
  <section id="approach" class="section">
    <span class="kicker" style="margin-bottom:32px">Approach</span>
    <h2 class="statement">Embedded, not external. Expertise, not theory. Your cadence, not ours.</h2>

    <div class="approach__split">
      <div class="approach__col">
        <p>Every family office is carrying more than it used to: succession, governance, a generational handover in progress, a regulatory shift that lands without warning. The volume itself is the problem as much as any single issue inside it.</p>
        <p>We work inside the family office, not outside it. No decks lobbed over the fence, no frameworks left behind for someone else to run. We sit with your team and do the work alongside them, lending expertise rather than adding another voice to manage.</p>
        <p>That holds whatever is moving through the landscape at the time. Right now AI is one of the things moving fastest, and we are not an AI practice because of it. We help families decide what to adopt, what to resist and what to govern, whether the subject is succession, structure or, currently, AI.</p>
      </div>
      <Plate ratio="4 / 5" src="/material.jpg" alt="An architectural oak joinery detail in raking light" label="Photograph · material" note="A single architectural detail, stone or oak, raking light across the surface. Material, craft, permanence. Restrained and close." spec="1100 × 1375" />
    </div>

    <div class="approach__verdict">
      <div class="gold-rule" style="margin-bottom:24px"></div>
      <p>We are not consultants who present. We are trusted because of years inside the nuance and cadence of family offices, not because we claim it.</p>
    </div>
  </section>

  <!-- PARTNERS -->
  <section id="partners" class="section">
    <span class="kicker" style="margin-bottom:56px">Partners</span>
    <div class="partners">
      <div class="partner">
        <div class="partner__head">
          <img src="/tom-rutherford.jpg" alt="Tom Rutherford" class="partner__img" />
          <div>
            <p class="partner__name">Tom Rutherford</p>
            <p class="partner__role">Family Office and Trust Advisor</p>
          </div>
        </div>
        <div class="partner__bio">
          <p>Nearly thirty years advising family offices and international trusts. Formed LOTUC Consulting in 2018 recognising the need for strategic advice incorporating sustainability alongside traditional frameworks.</p>
          <p>JPMorgan Private Bank, managing director leading charities and international manager due diligence team. Previous portfolio management experience at Lombard Odier and Robert Fleming &amp; Co.</p>
        </div>
      </div>
      <div class="partner partner--last">
        <div class="partner__head">
          <img src="/shaan-mahrotri.jpg" alt="Shaan Mahrotri" class="partner__img" />
          <div>
            <p class="partner__name">Shaan Mahrotri</p>
            <p class="partner__role">Strategic Advisor and Investor</p>
          </div>
        </div>
        <div class="partner__bio">
          <p>Accomplished operational advisor to investment houses, family offices, and UHNW individuals with over 25 years of expertise across diverse industries and geographies.</p>
          <p>Bridges strategy and execution through deep commercial expertise and extensive global network. Trusted advisor to principals and hands-on operator with portfolio companies, focusing on driving innovation and growth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- INSIGHTS SUMMARY -->
  <section id="insights" class="section insights-summary">
    <div class="insights-summary__head">
      <div>
        <span class="kicker" style="margin-bottom:18px">Insights</span>
        <h2 class="statement statement--tight">Writing on foundations, governance and the long work of family offices.</h2>
      </div>
      <a href="/insights" class="insights-summary__all">All insights →</a>
    </div>

    <div class="insights-summary__grid">
      <a href={`/insights/${featured.slug}`} class="feature">
        <Plate ratio="7 / 5" label="Photograph · feature" note="A foundation set out in string lines across cleared ground. Beginnings, order, intent." spec="1400 × 1000" />
        <div class="feature__meta">
          <span class="gold-tick"></span>
          <span class="feature__topic">{featured.data.topic}</span>
        </div>
        <h3 class="feature__title">{featured.data.title}</h3>
        <p class="feature__byline">{featured.data.author} · {featured.data.read} · {featured.data.date}</p>
      </a>

      <div class="summary-list">
        {summary.map((a) => (
          <a href={`/insights/${a.slug}`} class="summary-row">
            <div class="microlabel" style="margin-bottom:10px">{a.data.topic}</div>
            <h4 class="summary-row__title">{a.data.title}</h4>
            <p class="summary-row__meta">{a.data.author} · {a.data.date}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section">
    <span class="kicker" style="margin-bottom:40px">Contact</span>
    <div class="contact">
      <p class="contact__lead">We work with a small number of families at any one time. If you would like to explore whether we are the right fit, the best first step is a conversation.</p>
      <div class="contact__row">
        <span class="contact__name">Tom Rutherford</span>
        <a href="mailto:tom@valorapartners.co.uk" class="contact__mail">tom@valorapartners.co.uk</a>
      </div>
      <div class="contact__row">
        <span class="contact__name">Shaan Mahrotri</span>
        <a href="mailto:shaan@valorapartners.co.uk" class="contact__mail">shaan@valorapartners.co.uk</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 0.82fr;
    gap: 72px;
    align-items: center;
    padding: 40px var(--pad);
  }
  .hero__text { max-width: 560px; }
  .hero h1 { font-size: 42px; font-weight: 300; color: var(--ink); line-height: 1.28; letter-spacing: -0.2px; margin-bottom: 40px; }
  .hero__body { display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px; }
  .hero__body p { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.9; }
  .hero__maxim { font-size: 14px; font-weight: 400; color: var(--ink); letter-spacing: 0.08em; }
  .hero__plate { align-self: stretch; min-height: 520px; }

  .statement { font-size: 32px; font-weight: 300; color: var(--ink); line-height: 1.32; letter-spacing: -0.3px; max-width: 18em; margin-bottom: 64px; }
  .statement--tight { font-size: 30px; max-width: 16em; margin-bottom: 0; }

  .approach__split { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(0,0.95fr); gap: 72px; align-items: start; }
  .approach__col { max-width: 560px; display: flex; flex-direction: column; gap: 20px; }
  .approach__col p { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.9; }
  .approach__verdict { margin-top: 56px; padding-top: 36px; border-top: 1px solid var(--divider); max-width: 40em; }
  .approach__verdict p { font-size: 22px; font-weight: 300; color: var(--ink); line-height: 1.5; letter-spacing: -0.2px; }

  .microlabel { font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); margin-bottom: 18px; }

  .partners { display: flex; flex-direction: column; max-width: 600px; }
  .partner { padding-bottom: 52px; margin-bottom: 52px; border-bottom: 1px solid var(--divider); }
  .partner--last { padding-bottom: 0; margin-bottom: 0; border-bottom: none; }
  .partner__head { display: flex; align-items: center; gap: 28px; margin-bottom: 24px; }
  .partner__img { width: 90px; height: 90px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .partner__name { font-size: 16px; font-weight: 400; letter-spacing: 0.2em; color: var(--ink); text-transform: uppercase; margin-bottom: 8px; }
  .partner__role { font-size: 11px; font-weight: 700; letter-spacing: 0.25em; color: var(--gold); text-transform: uppercase; }
  .partner__bio { font-size: 15px; font-weight: 300; color: var(--muted); line-height: 1.9; }
  .partner__bio p + p { margin-top: 14px; }

  .insights-summary { background: var(--paper); }
  .insights-summary__head { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 48px; }
  .insights-summary__all { font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); border-bottom: 2px solid var(--gold); padding-bottom: 5px; white-space: nowrap; }
  .insights-summary__all:hover { color: var(--gold-deep); }
  .insights-summary__grid { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(0,0.95fr); gap: 64px; align-items: center; }

  .feature { display: block; }
  .feature__meta { display: flex; align-items: center; gap: 12px; margin: 24px 0 14px; }
  .gold-tick { width: 24px; height: 2px; background: var(--gold); }
  .feature__topic { font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
  .feature__title { font-size: 26px; font-weight: 300; color: var(--ink); line-height: 1.26; letter-spacing: -0.3px; }
  .feature:hover .feature__title { color: var(--gold-deep); }
  .feature__byline { font-size: 13px; font-weight: 400; color: var(--faint); letter-spacing: 0.04em; margin-top: 16px; }

  .summary-list { display: flex; flex-direction: column; }
  .summary-row { display: block; padding: 22px 0; border-top: 1px solid var(--divider); }
  .summary-row:hover { opacity: 0.72; }
  .summary-row__title { font-size: 18px; font-weight: 300; color: var(--ink); letter-spacing: -0.2px; line-height: 1.32; }
  .summary-row__meta { font-size: 12px; font-weight: 400; color: var(--faint); letter-spacing: 0.04em; margin-top: 10px; }

  .contact { max-width: 480px; }
  .contact__lead { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.9; margin-bottom: 52px; }
  .contact__row { margin-bottom: 36px; }
  .contact__name { display: block; font-size: 10px; font-weight: 700; letter-spacing: 0.35em; color: var(--gold); text-transform: uppercase; margin-bottom: 10px; }
  .contact__mail { font-size: 16px; font-weight: 400; color: var(--ink); letter-spacing: 0.04em; border-bottom: 1px solid var(--divider); padding-bottom: 3px; }
  .contact__mail:hover { border-color: var(--gold); }

  @media (max-width: 900px) {
    .hero, .approach__split, .insights-summary__grid { grid-template-columns: 1fr; gap: 40px; }
    .hero { min-height: 0; }
    .hero__plate { min-height: 360px; }
  }
</style>
