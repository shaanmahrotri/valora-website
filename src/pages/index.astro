---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Plate from '../components/Plate.astro';

const settings = await getEntry('settings', 'index');
const insightsEnabled = settings.data.insightsEnabled;

const insights = insightsEnabled
  ? (await getCollection('insights', ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order)
  : [];
const featured = insights[0];
const summary = insights.slice(1, 4);

const hero = await getEntry('hero', 'index');
const approach = await getEntry('approach', 'index');
const contact = await getEntry('contact', 'index');
const allPartners = await getCollection('partners');
const tom = allPartners.find((p) => p.data.name === 'Tom Rutherford')!;
const shaan = allPartners.find((p) => p.data.name === 'Shaan Mahrotri')!;
const partnersSection = await getEntry('partnersSection', 'index');
---

<Base title="Valora — Fractional Family Office Architecture" active="about">

  <!-- HERO -->
  <section id="about" class="hero">
    <div class="hero__text">
      <span class="kicker" style="margin-bottom:36px">{hero.data.kicker}</span>
      <h1>{hero.data.headline}</h1>
      <div class="hero__body">
        {hero.data.bodyParagraphs.map((p) => <p>{p}</p>)}
      </div>
      <p class="hero__maxim">{hero.data.maxim}</p>
    </div>
    <div class="hero__plate">
      <Plate fill={true} src={hero.data.photo} alt="A quiet, well-kept study in soft morning daylight" label="Photograph · hero" note="A quiet, well-kept study in soft morning daylight. Architecture and stillness, no people. Warm neutral tones, deep negative space." spec="1600 × 1800" />
    </div>
  </section>

  <!-- APPROACH -->
  <section id="approach" class="section">
    <span class="kicker" style="margin-bottom:32px">Approach</span>

    <div class="approach__split">
      <Plate ratio="9 / 22" src={approach.data.photo} alt="A tree-lined garden path leading toward a flight of stone steps" label="Photograph · material" note="A tree-lined path in dappled light, steps rising at its end. Patience, continuity, the long view." spec="900 × 2200" />
      <div class="approach__col">
        <h2 class="statement">{approach.data.tagline}</h2>
        {approach.data.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <div class="approach__verdict">
      <div class="gold-rule" style="margin-bottom:24px"></div>
      <p>{approach.data.verdict}</p>
    </div>
  </section>

  <!-- PARTNERS -->
  <section id="partners" class="section">
    <h2 class="kicker" style="margin-bottom:32px">Partners</h2>
    <p class="partners__intro">{partnersSection.data.intro}</p>
    <div class="partners">
      <div class="partner">
        <div class="partner__head">
          <img src={tom.data.photo} alt={tom.data.name} width="90" height="90" class="partner__img" />
          <div>
            <p class="partner__name">{tom.data.name}</p>
            <p class="partner__role">{tom.data.role}</p>
          </div>
        </div>
        <div class="partner__bio">
          {tom.data.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="partner">
        <div class="partner__head">
          <img src={shaan.data.photo} alt={shaan.data.name} width="90" height="90" class="partner__img" />
          <div>
            <p class="partner__name">{shaan.data.name}</p>
            <p class="partner__role">{shaan.data.role}</p>
          </div>
        </div>
        <div class="partner__bio">
          {shaan.data.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>

    <div class="partners__closing">
      <div class="gold-rule" style="margin-bottom:24px"></div>
      <p>{partnersSection.data.closing}</p>
    </div>
  </section>

  <!-- INSIGHTS SUMMARY -->
  {insightsEnabled && (
    <section id="insights" class="section insights-summary">
      <div class="insights-summary__head">
        <div>
          <span class="kicker" style="margin-bottom:18px">Insights</span>
          <h2 class="statement statement--tight">Writing on foundations, governance and the long work of family offices.</h2>
        </div>
        <a href="/insights" class="insights-summary__all">All insights →</a>
      </div>

      <div class="insights-summary__grid">
        <a href={`/insights/${featured.slug}`} class="feature">
          <Plate ratio="7 / 5" label="Photograph · feature" note="A foundation set out in string lines across cleared ground. Beginnings, order, intent." spec="1400 × 1000" src={featured.data.leadImage} alt={featured.data.title} />
          <div class="feature__meta">
            <span class="gold-tick"></span>
            <span class="feature__topic">{featured.data.topic}</span>
          </div>
          <h3 class="feature__title">{featured.data.title}</h3>
          <p class="feature__byline">{featured.data.author} · {featured.data.read} · {featured.data.date}</p>
        </a>

        <div class="summary-list">
          {summary.map((a) => (
            <a href={`/insights/${a.slug}`} class="summary-row">
              <div class="microlabel" style="margin-bottom:10px">{a.data.topic}</div>
              <h4 class="summary-row__title">{a.data.title}</h4>
              <p class="summary-row__meta">{a.data.author} · {a.data.date}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CONTACT -->
  <section id="contact" class="section">
    <h2 class="kicker" style="margin-bottom:40px">Contact</h2>
    <div class="contact">
      <p class="contact__lead">{contact.data.lead}</p>
      <div class="contact__row">
        <span class="contact__name">{tom.data.name}</span>
        <a href={`mailto:${tom.data.email}`} class="contact__mail">{tom.data.email}</a>
      </div>
      <div class="contact__row">
        <span class="contact__name">{shaan.data.name}</span>
        <a href={`mailto:${shaan.data.email}`} class="contact__mail">{shaan.data.email}</a>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 0.82fr;
    gap: 72px;
    align-items: center;
    padding: 40px var(--pad);
  }
  .hero__text { max-width: 560px; }
  .hero h1 { font-size: 42px; font-weight: 300; color: var(--ink); line-height: 1.28; letter-spacing: -0.2px; margin-bottom: 40px; text-wrap: balance; }
  .hero__body { display: flex; flex-direction: column; gap: 20px; margin-bottom: 40px; }
  .hero__body p { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.9; }
  .hero__maxim { font-size: 14px; font-weight: 400; color: var(--ink); letter-spacing: 0.08em; }
  .hero__plate { align-self: stretch; min-height: 520px; }

  .statement { font-size: 32px; font-weight: 300; color: var(--ink); line-height: 1.32; letter-spacing: -0.3px; max-width: 18em; margin-bottom: 64px; text-wrap: balance; }
  .statement--tight { font-size: 30px; max-width: 16em; margin-bottom: 0; }

  .approach__split { display: grid; grid-template-columns: minmax(0,0.95fr) minmax(0,1.05fr); gap: 72px; align-items: end; }
  .approach__col { max-width: 560px; display: flex; flex-direction: column; gap: 20px; }
  .approach__col .statement { max-width: none; margin-bottom: 8px; }
  .approach__col p { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.9; }
  .approach__verdict { margin-top: 56px; padding-top: 36px; border-top: 1px solid var(--divider); text-align: center; }
  .approach__verdict .gold-rule { margin: 0 auto 24px; }
  .approach__verdict p { font-size: 22px; font-weight: 300; color: var(--ink); line-height: 1.5; letter-spacing: -0.2px; max-width: 44em; margin: 0 auto; }

  .microlabel { font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); margin-bottom: 18px; }

  .partners__intro { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.9; max-width: 560px; margin-bottom: 56px; }
  .partners { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--divider); }
  .partner { padding: 52px 56px 52px 0; border-right: 1px solid var(--divider); }
  .partner:last-child { padding: 52px 0 52px 56px; border-right: none; }
  .partner__head { display: flex; align-items: center; gap: 28px; margin-bottom: 24px; }
  .partner__img { width: 90px; height: 90px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .partner__name { font-size: 16px; font-weight: 400; letter-spacing: 0.2em; color: var(--ink); text-transform: uppercase; margin-bottom: 8px; }
  .partner__role { font-size: 11px; font-weight: 700; letter-spacing: 0.25em; color: var(--body); text-transform: uppercase; }
  .partner__bio { font-size: 15px; font-weight: 300; color: var(--muted); line-height: 1.9; }
  .partner__bio p + p { margin-top: 14px; }

  .partners__closing { margin-top: 56px; padding-top: 36px; border-top: 1px solid var(--divider); max-width: 600px; }
  .partners__closing p { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.9; }

  .insights-summary { background: var(--paper); }
  .insights-summary__head { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 48px; }
  .insights-summary__all { font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); border-bottom: 2px solid var(--gold); padding-bottom: 5px; white-space: nowrap; }
  .insights-summary__grid { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(0,0.95fr); gap: 64px; align-items: center; }

  .feature { display: block; }
  .feature__meta { display: flex; align-items: center; gap: 12px; margin: 24px 0 14px; }
  .gold-tick { width: 24px; height: 2px; background: var(--gold); }
  .feature__topic { font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink); }
  .feature__title { font-size: 26px; font-weight: 300; color: var(--ink); line-height: 1.26; letter-spacing: -0.3px; text-wrap: balance; }
  .feature:hover .feature__title { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 4px; }
  .feature__byline { font-size: 13px; font-weight: 400; color: var(--muted); letter-spacing: 0.04em; margin-top: 16px; }

  .summary-list { display: flex; flex-direction: column; }
  .summary-row { display: block; padding: 22px 0; border-top: 1px solid var(--divider); }
  .summary-row:hover { opacity: 0.72; }
  .summary-row__title { font-size: 18px; font-weight: 300; color: var(--ink); letter-spacing: -0.2px; line-height: 1.32; }
  .summary-row__meta { font-size: 12px; font-weight: 400; color: var(--muted); letter-spacing: 0.04em; margin-top: 10px; }

  .contact { max-width: 480px; }
  .contact__lead { font-size: 16px; font-weight: 300; color: var(--muted); line-height: 1.9; margin-bottom: 52px; }
  .contact__row { margin-bottom: 36px; }
  .contact__name { display: block; font-size: 10px; font-weight: 700; letter-spacing: 0.35em; color: var(--ink); text-transform: uppercase; margin-bottom: 10px; }
  .contact__mail { font-size: 16px; font-weight: 400; color: var(--ink); letter-spacing: 0.04em; border-bottom: 1px solid var(--divider); padding-bottom: 3px; }
  .contact__mail:hover { border-color: var(--gold); }

  @media (max-width: 900px) {
    .hero, .approach__split, .insights-summary__grid { grid-template-columns: 1fr; gap: 40px; }
    .hero { min-height: 0; scroll-margin-top: 56px; }
    .hero__plate { min-height: 360px; }
    /* text first on mobile — image drops below */
    .approach__split :global(.plate) { order: 2; aspect-ratio: 4 / 5 !important; }
    .approach__col { order: 1; }
    /* partners stack vertically on mobile */
    .partners { grid-template-columns: 1fr; border-top: none; }
    .partner { padding: 40px 0; border-right: none; border-top: 1px solid var(--divider); }
    .partner:last-child { padding: 40px 0 0; }
  }
</style>
