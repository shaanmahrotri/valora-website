---
import '../styles/global.css';

interface Props {
  title: string;
  pageLabel: string;
  active: 'about' | 'partners' | 'insights' | 'contact';
}

const { title, pageLabel, active } = Astro.props;

const navItems: { href: string; label: string; key: Props['active'] }[] = [
  { href: '/', label: 'About', key: 'about' },
  { href: '/partners', label: 'Partners', key: 'partners' },
  { href: '/insights', label: 'Insights', key: 'insights' },
  { href: '/contact', label: 'Contact', key: 'contact' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
</head>
<body>
<div class="site">

  <aside class="panel">
    <div>
      <p class="slash">/</p>
      <p class="brand">VALORA</p>
      <div class="gold-rule"></div>
      <nav class="nav">
        {navItems.map((item) => (
          <a href={item.href} class={`nav-link ${active === item.key ? 'active' : ''}`}>{item.label}</a>
        ))}
      </nav>
    </div>
    <p class="panel-foot">© Valora 2026</p>
  </aside>

  <main class="content">
    <span class="page-label">{pageLabel}</span>
    <slot />
  </main>

</div>
</body>
</html>
