# Supabase Postgres connection (Project Settings > Database). Prefer the direct
# connection or session-mode pooler. See docs/crm-setup.md.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# Strong random secret for NocoDB auth (e.g. openssl rand -hex 32).
NC_AUTH_JWT_SECRET=
