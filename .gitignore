# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# environment
.env
.env.production

# macOS
.DS_Store

# Netlify CLI local state
.netlify/

# skill eval scratch (test run outputs, not part of the skill itself)
.claude/skills/*-workspace/

# Python venvs bundled with skills (e.g. questionnaire-pdf-export) - local,
# machine-specific, reinstalled from scripts/requirements.txt, never committed
.venv/

# generated PDF exports contain real respondent PII - never committed, even
# if a skill is ever run with a relative/local output path by mistake
.claude/skills/*/output/
.claude/skills/*/pdfs/
