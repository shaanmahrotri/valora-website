# Required by netlify/functions/submit-questionnaire.mjs,
# netlify/functions/confirm-subscription.mjs and
# netlify/functions/unsubscribe.mjs. Set these in the Netlify site's
# environment variables (Project configuration > Environment variables) -
# never commit real values, and never expose the
# SUPABASE_SERVICE_ROLE_KEY to client-side code.
#
# unsubscribe.mjs needs SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# CONSENT_TOKEN_SECRET and RESEND_CONTACTS_API_KEY. confirm-subscription.mjs
# now also uses RESEND_CONTACTS_API_KEY and RESEND_AUDIENCE_ID (Resend
# Audience sync, below).

# Supabase project URL and service_role key (Project Settings > API).
# The service_role key bypasses Row Level Security - it's only ever used
# server-side, inside the three Netlify Functions above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) API key, from a verified sending domain. Used ONLY for
# sending actual emails (submit-questionnaire.mjs) - give this one Sending
# access only (Resend's own recommended default), not Full access.
RESEND_API_KEY=
# A SEPARATE Resend API key with Full access (or at minimum Contacts
# permissions), used ONLY by confirm-subscription.mjs and unsubscribe.mjs to
# manage the Resend Audience/Segment. Deliberately not the same key as
# RESEND_API_KEY above - confirmed live that a Sending-access key gets a 401
# restricted_api_key error from the Contacts API, and giving the sending key
# Full access instead would mean a leaked key could also delete contacts,
# not just send email. Create this as a second key in the Resend dashboard.
RESEND_CONTACTS_API_KEY=
# Resend Audience that confirmed marketing-consent contacts are upserted into
# (confirm-subscription.mjs). Create an Audience/Segment in the Resend
# dashboard and copy its ID. Leave blank to skip the audience sync entirely.
RESEND_AUDIENCE_ID=
# The "from" address for all outbound mail - must be on the verified domain.
NOTIFY_EMAIL_FROM="Valora Partners <hello@valorapartners.co.uk>"
# Optional: internal address that gets pinged on every new submission.
# Leave blank to skip internal notifications entirely. Comma-separate to
# notify more than one address (e.g. both partners).
NOTIFY_EMAIL_TO=

# Random secret used to sign the double opt-in confirmation link
# (HMAC-SHA256). Generate one with: openssl rand -hex 32
CONSENT_TOKEN_SECRET=

# Optional: a label written onto each response row recording which
# version of the privacy policy was in effect at submission time.
PRIVACY_POLICY_VERSION=

# The base URL used to build confirm-subscription/unsubscribe links in
# emails. Netlify Functions do NOT get a built-in way to know which deploy
# context they're running in (only URL, SITE_NAME and SITE_ID are available
# at runtime - DEPLOY_PRIME_URL etc. are build-time only, despite several
# online examples implying otherwise). Set this in the Netlify UI scoped
# per deploy context (Site configuration > Environment variables > this
# variable > "Different value for each deploy context"):
#   Production           -> https://valorapartners.co.uk
#   Branch deploys        -> the astro-rebuild branch's own URL
# Leave unset and it falls back to Netlify's built-in URL, which is always
# the production domain regardless of context - fine for production, wrong
# for testing links from a branch deploy.
DEPLOY_BASE_URL=
